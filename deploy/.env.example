# ============ MySQL ============
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=yszx123456
# 本机 3306 被其他项目占用，使用 3307
MYSQL_PORT=3307

# ============ Redis ============
# 本机 6379 被其他项目占用，使用 6380
REDIS_PORT=6380
REDIS_HOST=localhost

# ============ MinIO ============
# 官方镜像拉取受限时保持默认；如可直连 Docker Hub 可改为 minio/minio:latest
MINIO_IMAGE=docker.1ms.run/bitnamilegacy/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=yszx
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============ 后端连接（与上面保持一致） ============
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# ============ JWT（生产必须替换为 32 字节以上随机串） ============
APP_JWT_PORTAL_SECRET=change-me-portal-secret-at-least-32-bytes
APP_JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-bytes

# ============ 后台内置管理员初始密码 ============
APP_DEFAULT_PASSWORD=Admin@123456

# ============ AI 能力（OpenAI 兼容协议，境内可直连服务） ============
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
